{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:stage13:ci-failure-triage-output:v1",
  "title": "Stage13 CI Failure Triage Output v1",
  "description": "WP00 冻结合同；不进入正式 Runtime。身份、输出版本和 provenance 位于授权回执 envelope。",
  "type": "object",
  "additionalProperties": false,
  "required": ["FailureCategory", "RootCauseCandidates", "EvidenceRefs", "RecommendedAction", "Confidence", "NeedMoreEvidence", "TicketDecision"],
  "properties": {
    "FailureCategory": {
      "enum": ["PRODUCT", "TEST_CASE", "TEST_DATA", "ENVIRONMENT", "TOOL_CHAIN", "INFRASTRUCTURE", "UNKNOWN"]
    },
    "RootCauseCandidates": {
      "type": "array",
      "maxItems": 3,
      "items": {"$ref": "#/$defs/candidate"}
    },
    "EvidenceRefs": {
      "type": "array",
      "maxItems": 32,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/evidenceRef"}
    },
    "RecommendedAction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ActionCode"],
      "properties": {
        "ActionCode": {"enum": ["INVESTIGATE_PRODUCT", "FIX_TEST", "FIX_TEST_DATA", "RETRY_ENVIRONMENT", "REPAIR_TOOL_CHAIN", "RESTORE_INFRASTRUCTURE", "REQUEST_MORE_EVIDENCE", "ESCALATE_HUMAN", "NO_ACTION"]},
        "Explanation": {"type": "string", "maxLength": 1024}
      }
    },
    "Confidence": {"type": "number", "minimum": 0, "maximum": 1},
    "NeedMoreEvidence": {"type": "boolean"},
    "TicketDecision": {"enum": ["CREATE_PRODUCT_TICKET", "IGNORE", "REQUEST_MORE_EVIDENCE", "ESCALATE_HUMAN"]}
  },
  "allOf": [
    {
      "if": {"properties": {"NeedMoreEvidence": {"const": true}}, "required": ["NeedMoreEvidence"]},
      "then": {"properties": {"RecommendedAction": {"properties": {"ActionCode": {"const": "REQUEST_MORE_EVIDENCE"}}}, "TicketDecision": {"const": "REQUEST_MORE_EVIDENCE"}}}
    },
    {
      "if": {"properties": {"TicketDecision": {"const": "REQUEST_MORE_EVIDENCE"}}, "required": ["TicketDecision"]},
      "then": {"properties": {"NeedMoreEvidence": {"const": true}}}
    },
    {
      "if": {"properties": {"RecommendedAction": {"properties": {"ActionCode": {"const": "REQUEST_MORE_EVIDENCE"}}, "required": ["ActionCode"]}}, "required": ["RecommendedAction"]},
      "then": {"properties": {"NeedMoreEvidence": {"const": true}}}
    },
    {
      "if": {"properties": {"FailureCategory": {"const": "UNKNOWN"}}, "required": ["FailureCategory"]},
      "then": {"properties": {"TicketDecision": {"enum": ["REQUEST_MORE_EVIDENCE", "ESCALATE_HUMAN"]}, "RecommendedAction": {"properties": {"ActionCode": {"enum": ["REQUEST_MORE_EVIDENCE", "ESCALATE_HUMAN"]}}}}}
    },
    {
      "if": {"properties": {"TicketDecision": {"const": "CREATE_PRODUCT_TICKET"}}, "required": ["TicketDecision"]},
      "then": {"properties": {"NeedMoreEvidence": {"const": false}, "RootCauseCandidates": {"minItems": 1}, "EvidenceRefs": {"minItems": 1}}}
    }
  ],
  "$defs": {
    "safeId": {"type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:/@-]*$"},
    "evidenceRef": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evidence_id", "digest", "type"],
      "properties": {
        "evidence_id": {"$ref": "#/$defs/safeId"},
        "digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "type": {"enum": ["CI_SUMMARY", "FAILURE_DETAIL", "ERROR_EXCERPT", "ENVIRONMENT_METADATA", "VERSION_METADATA", "CHANGE_METADATA", "HISTORICAL_KNOWN_FAILURE", "AUTHORIZED_ARTIFACT"]}
      }
    },
    "causeDescriptor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component_id", "mechanism_code", "change_ref"],
      "properties": {
        "component_id": {"$ref": "#/$defs/safeId"},
        "mechanism_code": {"enum": ["PRODUCT_BEHAVIOR", "TEST_LOGIC", "TEST_DATA", "ENVIRONMENT_CONFIG", "TOOL_EXECUTION", "INFRASTRUCTURE_SERVICE", "UNKNOWN"]},
        "change_ref": {"anyOf": [{"$ref": "#/$defs/safeId"}, {"type": "null"}]}
      }
    },
    "candidate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["candidate_id", "rank", "summary", "cause_descriptor", "evidence_refs", "confidence"],
      "properties": {
        "candidate_id": {"type": "string", "pattern": "^candidate-[1-3]$"},
        "rank": {"type": "integer", "minimum": 1, "maximum": 3},
        "summary": {"type": "string", "minLength": 1, "maxLength": 1024},
        "cause_descriptor": {"$ref": "#/$defs/causeDescriptor"},
        "evidence_refs": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"$ref": "#/$defs/safeId"}},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1}
      }
    }
  }
}
