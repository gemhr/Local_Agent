# LocalAgent Environment Variable Template
#
# 本文件只作为配置名称/模板文档，Application 不自动加载（不存在 dotenv loader）。
# operator 可将需要的内容复制为 PowerShell 环境变量：
#   $env:LOCAL_AGENT_ENVIRONMENT_PROFILE="LOCAL"
#
# 不得在此文件写入真实 secret、真实 API Key、真实 Wiki Cookie 或内部真实 URL。

# ---- Environment ----
LOCAL_AGENT_ENVIRONMENT_PROFILE=LOCAL
LOCAL_AGENT_ENVIRONMENT_ID=local

# ---- Server / Client networking ----
LOCAL_AGENT_API_HOST=127.0.0.1
LOCAL_AGENT_API_PORT=8000
LOCAL_AGENT_API_BASE_URL=http://127.0.0.1:8000

# ---- Runtime ----
CHAT_RUNTIME_MODE=COORDINATED

# ---- Model ----
LOCAL_AGENT_MODEL_PROFILE=balanced
LOCAL_AGENT_LLM_BACKEND=remote
LOCAL_AGENT_MODEL_MAX_TOKENS=4096
LOCAL_AGENT_MODEL_PATH=data/models/qwen2.5-7b-instruct-q4_k_m.gguf
LOCAL_AGENT_EMBEDDING_MODEL_PATH=data/models/Qwen3-Embedding-0.6B

# ---- Remote provider（secret 留空 / placeholder）----
LOCAL_AGENT_REMOTE_MODEL_NAME=deepseek-v4-flash
LOCAL_AGENT_REMOTE_PROVIDER_KIND=deepseek
LOCAL_AGENT_REMOTE_API_BASE_URL=<configured-outside-docs>
LOCAL_AGENT_REMOTE_API_KEY=<secret-store-reference>
LOCAL_AGENT_REMOTE_TIMEOUT_SECONDS=120
LOCAL_AGENT_REMOTE_ENABLE_THINKING=0
LOCAL_AGENT_REMOTE_CONTEXT_WINDOW=1000000
LOCAL_AGENT_REMOTE_VERIFY_TLS=1
LOCAL_AGENT_REMOTE_TRUST_ENV=0

# ---- JWT verification（公钥正文由本机 secret source 注入）----
LOCAL_AGENT_JWT_PUBLIC_KEY=
LOCAL_AGENT_JWT_ISSUER=localagent
LOCAL_AGENT_JWT_AUDIENCE=localagent-api

# ---- Client HTTP Proxy ----
# 控制 Desktop Client → LocalAgent Server Session 是否继承系统 proxy。
# 与 LOCAL_AGENT_REMOTE_TRUST_ENV 完全独立。
LOCAL_AGENT_CLIENT_TRUST_ENV=1

# ---- PostgreSQL Canonical Persistence（Stage6-WP1；SERVER 进程必填）----
# Runtime Journal / Snapshot / Event Consumer Checkpoint 的权威存储。
# DSN 是 secret：不要提交真实凭据，也不要打印到日志或错误正文。
# schema 由显式 `uv run alembic upgrade head` 创建；API startup 绝不迁移。
LOCAL_AGENT_DATABASE_URL=<secret-store-reference>
LOCAL_AGENT_DB_POOL_SIZE=5
LOCAL_AGENT_DB_MAX_OVERFLOW=5
LOCAL_AGENT_DB_POOL_TIMEOUT_SECONDS=5.0
LOCAL_AGENT_DB_POOL_RECYCLE_SECONDS=1800
LOCAL_AGENT_DB_CONNECT_TIMEOUT_SECONDS=5.0
LOCAL_AGENT_DB_STATEMENT_TIMEOUT_MS=15000
LOCAL_AGENT_DB_LOCK_TIMEOUT_MS=5000
LOCAL_AGENT_DB_IDLE_IN_TRANSACTION_TIMEOUT_MS=10000

# ---- Persistent data（默认路径；也可显式覆盖）----
# Stage6-WP1：conversation / advanced / project Memory 均使用下方
# PostgreSQL Canonical Persistence；不提供 SQLite fallback。
LOCAL_AGENT_SNAPSHOT_ENABLED=0
LOCAL_AGENT_CHROMA_DIR=chroma_db
LOCAL_AGENT_LOCAL_KB_DIR=data/knowledge_base

# ---- Knowledge sync（cookie 留空 / placeholder）----
LOCAL_AGENT_SYNC_ENABLED=0
LOCAL_AGENT_WIKI_COOKIE=<secret-store-reference>

# ---- MCP Integration（Phase9-WP1，默认关闭）----
# 指向 operator 本地 JSON 配置文件（schema localagent-mcp-config.v1），
# 内容包含 server identity/command/arguments/environment/enabled。
# 该文件属于本地 operator 配置，不得提交进仓库；environment 值通常含 secret。
# 留空 = 不构造 MCP 集成组件、不启动任何子进程。
LOCAL_AGENT_MCP_CONFIG_PATH=
LOCAL_AGENT_MCP_CONNECT_TIMEOUT_SECONDS=5.0
LOCAL_AGENT_MCP_REQUEST_TIMEOUT_SECONDS=10.0
# ---- Compose-only overrides（不要提交真实 .env）----
POSTGRES_DB=localagent
POSTGRES_USER=localagent
POSTGRES_PASSWORD=replace-with-random-local-password
LOCAL_AGENT_REDIS_URL=redis://redis:6379/0
LOCAL_AGENT_KAFKA_BOOTSTRAP_SERVERS=kafka:9092
LOCAL_AGENT_KAFKA_ENABLED=1
LOCAL_AGENT_KAFKA_JOB_TOPIC=evaluation.jobs.v1
LOCAL_AGENT_KAFKA_JOB_DLQ_TOPIC=evaluation.jobs.v1.dlq
LOCAL_AGENT_KAFKA_CONSUMER_GROUP=localagent-evaluation-worker-v1
