  "common_field_rules": {
    "attributes": {
      "presence": "OPTIONAL",
      "type": "STRICT_CATEGORY_ALLOWLIST_MAPPING"
    },
    "completed_at": {
      "presence": "REQUIRED",
      "rule": "not earlier than started_at",
      "type": "UTC_WALL_CLOCK"
    },
    "component": {
      "presence": "REQUIRED",
      "type": "SAFE_IDENTIFIER"
    },
    "duration_ms": {
      "presence": "REQUIRED",
      "type": "FINITE_NON_NEGATIVE_NUMBER"
    },
    "error_code": {
      "presence": "CONDITIONAL",
      "rule": "absent for OK; required safe identifier otherwise",
      "type": "SAFE_IDENTIFIER_OR_ABSENT"
    },
    "operation": {
      "presence": "REQUIRED",
      "type": "SAFE_OPERATION_IDENTIFIER"
    },
    "parent_span_id": {
      "presence": "OPTIONAL",
      "type": "SAFE_IDENTIFIER_OR_ABSENT"
    },
    "run_id": {
      "presence": "REQUIRED",
      "type": "SAFE_IDENTIFIER"
    },
    "span_id": {
      "presence": "REQUIRED",
      "type": "SAFE_IDENTIFIER"
    },
    "started_at": {
      "presence": "REQUIRED",
      "type": "UTC_WALL_CLOCK"
    },
    "status": {
      "presence": "REQUIRED",
      "type": "TERMINAL_SPAN_STATUS"
    },
    "step_id": {
      "presence": "CONDITIONAL",
      "rule": "required for step-bound operations; absent for run/planning",
      "type": "SAFE_IDENTIFIER_OR_ABSENT"
    },
    "trace_id": {
      "presence": "REQUIRED",
      "type": "SAFE_IDENTIFIER"
    }
  },
  "compatibility_behavior": {
    "fingerprint_missing_or_malformed_or_unsupported": "REJECT",
    "identity_missing_or_mismatch": "REJECT",
    "known_identity_version_fingerprint_invalid_envelope_semantics": "REJECT_ENVELOPE_INVALID",
    "known_identity_version_fingerprint_valid_semantics": "ACCEPT",
    "version_unsupported": "REJECT"
  },
  "compatibility_reasons": [
    "ACCEPTED",
    "ENVELOPE_INVALID",
    "FINGERPRINT_MALFORMED",
    "FINGERPRINT_MISSING",
    "FINGERPRINT_UNSUPPORTED",
    "IDENTITY_MISMATCH",
    "IDENTITY_MISSING",
    "VERSION_UNSUPPORTED"
  ],
  "contract_identity": "localagent.runtime.trace_export",
  "contract_version": 1,
  "direct_constructor_policy": "strict semantic validation via shared path; no public construction bypass",
  "extension_operation_policy": {
    "classification": "INTERNAL_RC",
    "projected": false,
    "rule": "lower-level model/tool/retrieval operations rejected as UNSUPPORTED_OPERATION; never stable top-level operations"
  },
  "runtime_trace_contract_version": 1,
  "security_policy": {
    "boundary": "metadata_first_strict_allowlist",
    "forbidden": "raw user/agent/model/tool/RAG/memory content, paths, URLs, secrets, raw exceptions never exported",
    "placeholder_attribution": "runtime_version/prompt_version/model_config_hash/toolset_hash/kb_version not_configured; NOT_PART_OF_WP4A; never exported"
  },
  "stable_operations": {
    "runtime.final_memory_commit": {
      "category": "memory",
      "step_bound": true
    },
    "runtime.output_delivery": {
      "category": "delivery",
      "step_bound": true
    },
    "runtime.planning": {
      "category": "planning",
      "step_bound": false
    },
    "runtime.run": {
      "category": "run",
      "step_bound": false
    },
    "runtime.step": {
      "category": "step",
      "step_bound": true
    },
    "runtime.synthesis": {
      "category": "synthesis",
      "step_bound": true
    }
  },
  "status_error_rule": {
    "non_ok": "safe_error_code_present",
    "ok": "error_code_absent"
  },
  "terminal_statuses": {
    "CANCELLED": {},
    "ERROR": {},
    "OK": {},
    "TIMED_OUT": {}
  },
  "unknown_attribute_behavior": {
    "direct_constructor_unknown_attribute": "INVALID",
    "project_span_unknown_internal_attribute": "OMIT"
  }
}
